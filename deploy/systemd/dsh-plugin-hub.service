[Unit]
Description=DSH Plugin Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/apps/dsh-plugin-hub/current
EnvironmentFile=/etc/dsh-plugin-hub/dsh-plugin-hub.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=18200
ExecStart=/home/deploy/.local/node22/bin/node /home/deploy/apps/dsh-plugin-hub/current/.next/standalone/server.js
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
